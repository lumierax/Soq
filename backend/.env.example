# Copy to .env locally on the server. NEVER commit populated secrets.
# Load with: uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000
APP_TOKEN=replace-with-a-long-random-token
# Non-loopback listening requires APP_TOKEN, and HTTPS at the reverse proxy.
CORS_ORIGINS=capacitor://localhost,http://localhost,http://localhost:5173,http://127.0.0.1:5173
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Use Binance futures testnet credentials for testnet. Do not enable live with testnet keys.
ALLOW_LIVE_TRADING=false
BOT_DB_PATH=./data/bot.sqlite3
NABD_DATA_DIR=./data
# Optional Telegram notifications. These are NOT Binance credentials.
# Exact numeric private/group chat ID only; no Telegram trading commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Market access must be supported in the server's jurisdiction.
